APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Debug das regras de amarração (ordem, match palavra_chave, match parte_digitavel) em storage/logs/laravel.log
# REGRAS_AMARRACAO_DEBUG=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Deve ser > timeout do worker automacoes (900). Evita MaxAttempts em jobs longos.
# DB_QUEUE_RETRY_AFTER=960

# Automação fiscal: true = FakePortalDriver (sem acesso real a portais)
AUTOMACAO_FISCAL_FAKE_MODE=true
AUTOMACAO_FISCAL_TIMEOUT_MS=300000
AUTOMACAO_FISCAL_RUNNER_TOKEN=integrar-dev-runner-token
# Entrada = login A1 direto (igual automacao-portais). Não use a página de atendimento.
ECAC_RS_ENTRY_URL=https://www.sefaz.rs.gov.br/Login/LoginCertACRS.aspx?codTpLogin=1
ECAC_RS_CERT_ORIGINS=https://www.sefaz.rs.gov.br
NFSE_EMISSOR_CERT_ORIGINS=https://certificado.nfse.gov.br

# WS Contabilista SEFAZ-RS (download XML por chave com A1 do escritório)
# NFE_CONTABILISTA_URL=https://nfe-rs-integracao.sefazvirtual.rs.gov.br/ws/NfeIntegracao/NfeIntegracao.asmx
# NFE_CONTABILISTA_TP_AMB=1
# NFE_CONTABILISTA_VER_APLIC=IntegrarExpert1.0
# NFE_CONTABILISTA_TIMEOUT_S=12
# NFE_CONTABILISTA_CONNECT_TIMEOUT_S=5

# DistDFe AN + Ciência 210210 (A1 do destinatário/cliente)
# NFE_DISTDFE_URL=https://www1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx
# NFE_RECEPCAO_EVENTO_URL=https://www.nfe.fazenda.gov.br/NFeRecepcaoEvento4/NFeRecepcaoEvento4.asmx
# NFE_DISTDFE_TP_AMB=1
# NFE_DISTDFE_CUF_AUTOR=43
# NFE_DISTDFE_TIMEOUT_S=60
# NFE_DISTDFE_RETRY_COUNT=3
# NFE_DISTDFE_RETRY_DELAY_S=20

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Web (Evolution API)
# Produção nativa: Docker só da Evolution, PHP fala em http://127.0.0.1:8080 (igual EfiConnect).
# Neste host de desenvolvimento o 8080 é do EfiConnect — use 8083.
EVOLUTION_PORT=8083
EVOLUTION_URL_BASE=http://evolution-api:8080
EVOLUTION_API_KEY=integrar-evolution-dev-key
EVOLUTION_WEBHOOK_URL=http://app:8000/webhooks/evolution

# Google Drive — opcional no .env. O escritório também informa ID e chave na tela Documentos → Google Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"
DOCUMENTOS_MAX_ANEXO_MB=80
DOCUMENTOS_QUEUE=documentos

# IA para classificar documentos (fallback se o escritório não cadastrou na tela Documentos → IA)
GEMINI_API_KEY=
GROQ_API_KEY=
LLAMA_CLOUD_API_KEY=

